{
  "manifest_version": 3,
  "name": "Creator Scout",
  "version": "4.6",
  "description": "Scout Instagram and YouTube creators and reels, keep them in the extension, copy to Sheets, and moodboard them by brand.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Creator Scout"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.make.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://www.googleapis.com/*",
    "https://drive.google.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}