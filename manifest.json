{
  "manifest_version": 3,
  "name": "Creator Scout",
  "version": "4.0",
  "description": "Scout Instagram and YouTube creators and reels, keep them in the extension, copy to Sheets, and moodboard them by brand.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.make.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://www.googleapis.com/*"
  ]
}
