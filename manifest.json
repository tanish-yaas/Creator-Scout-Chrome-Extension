{
  "manifest_version": 3,
  "name": "Creator Scout",
  "version": "2.0",
  "description": "Scout and save Instagram and YouTube creators to your Database.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://script.google.com/*",
    "https://*.make.com/*",
    "https://*.zapier.com/*",
    "https://www.googleapis.com/*"
  ]
}